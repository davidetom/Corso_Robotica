\begin{tabular}{|c|c|c|c|c|}
\hline
Link & $a_i$ (m) & $d_i$ (m) & $\theta_i$ & $\alpha_i$ \\
\hline
1 & $0$ & $0$ & $\theta_1$ & $-\pi/2$ \\
2 & $0$ & $0$ & $\theta_2$ & $-\pi/2$ \\
3 & $0$ & $-0.28$ & $\theta_3$ & $-\pi/2$ \\
4 & $-0.28$ & $0$ & $\theta_4$ & $-\pi/2$ \\
5 & $0$ & $0$ & $\theta_5$ & $\pi/2$ \\
